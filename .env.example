# Neon Postgres connection string (sslmode=require ile)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Token imzalama için uzun rastgele bir string (production için MUTLAKA değiştir)
JWT_SECRET=change-me-to-a-long-random-string

# Local server portu (Vercel'de kullanılmaz)
PORT=3010
